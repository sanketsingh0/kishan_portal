# =============================================================================
# KisanProcure - environment variable template
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file (it is gitignored).
# Keep ALL secrets out of source code.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
# Which config to load: development | testing | production
FLASK_ENV=development

# Secret key used for session signing.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Host/port for `python run.py` (local development only)
HOST=127.0.0.1
PORT=5000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development uses SQLite automatically when this is left empty.
# For Supabase PostgreSQL (production), use:
#   postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase (Auth)
# -----------------------------------------------------------------------------
# Supabase Dashboard > Settings > API (project URL + keys)
# Anonymous key and service role key are required only once the
# authentication module is implemented.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# JWT (Supabase-issued tokens)
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXP=3600

# -----------------------------------------------------------------------------
# Realtime (Flask-SocketIO)
# -----------------------------------------------------------------------------
# threading (default; works on the built-in dev server) | eventlet | gevent
SOCKETIO_ASYNC_MODE=threading
CORS_ALLOWED_ORIGINS=*