# =============================================================================
# KisanProcure - environment variable template
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file (it is gitignored).
# Keep ALL secrets out of source code.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
# Which config to load: development | testing | production
FLASK_ENV=development

# Secret key used for session signing.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Host/port for `python run.py` (local development only)
HOST=127.0.0.1
PORT=5000

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Local development uses SQLite automatically when this is left empty.
# PRODUCTION WILL NOT START without DATABASE_URL.
#
# Where to find it in Supabase:
#   Supabase Dashboard -> Project Settings -> Database
#   -> "Connection string" section (URI / connection string tab).
#   It looks like:  postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#
# Prefix it with the psycopg (v3) SQLAlchemy driver:
#   postgresql+psycopg://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# Add the SSL requirement (psycopg v3 style):
#   ...?sslmode=require
# URL-encode any special characters in the password (e.g. @ -> %40).
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase (Auth)
# -----------------------------------------------------------------------------
# Supabase Dashboard > Settings > API (project URL + keys)
#
# Two sets of variable names are supported (the app checks both):
#   Canonical (preferred):              Legacy alias (still works):
#     SUPABASE_ANON_KEY                  <- SUPABASE_PUBLISHABLE_KEY
#     SUPABASE_SERVICE_ROLE_KEY          <- SUPABASE_SECRET_KEY
#
# You may keep either naming scheme (or both) in your .env - the app reads
# the canonical name first and falls back to the legacy alias. If you copy an
# older .env that uses SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY, nothing
# needs to change.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# IMPORTANT - which variables are safe for frontend vs server-only:
#   - SUPABASE_URL:      SAFE for frontend (public project URL)
#   - SUPABASE_ANON_KEY: SAFE for frontend (public anon key;
#     legacy alias: SUPABASE_PUBLISHABLE_KEY)
#   - SUPABASE_SERVICE_ROLE_KEY: SERVER-ONLY (admin access to all data);
#     legacy alias: SUPABASE_SECRET_KEY
#     NEVER expose this to browser JavaScript. Keep it in .env only.

# -----------------------------------------------------------------------------
# JWT (Supabase-issued tokens)
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXP=3600

# -----------------------------------------------------------------------------
# Realtime (Flask-SocketIO)
# -----------------------------------------------------------------------------
# threading is the only supported mode and the default: it works on the
# built-in dev server and under gunicorn's default sync workers (production
# start command: `gunicorn -w 2 -b 0.0.0.0:$PORT run:app`). No eventlet
# or gevent is required or installed.
SOCKETIO_ASYNC_MODE=threading
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Web Browser Push Notifications (VAPID Configuration - Task 13)
# -----------------------------------------------------------------------------
# VAPID public/private keypair for web push delivery (e.g. pywebpush)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@kisanprocure.example.com