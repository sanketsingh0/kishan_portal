# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments -----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Environment / secrets -----------------------------------------------------
.env
.env.*
!.env.example
.flaskenv

# --- Databases -----------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
instance/

# --- Test / tooling caches -------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.coverage.xml

# --- IDE / OS ----------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---------------------------------------------------------------------------
*.log

# --- Node.js / frontend tooling (not used by the Flask app) ------------------------
node_modules/
package.json
package-lock.json

# --- Migration runtime artifacts (keep the Python scripts themselves committed) -----
migrations/versions/*.pyc